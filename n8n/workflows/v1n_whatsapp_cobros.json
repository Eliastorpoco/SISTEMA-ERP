    {
      "parameters":{"jsCode":"const b=$json.body||$json; const data=b.data||b; const key=data.key||b.key||{}; const event=String(b.event||data.event||'').toUpperCase().replace(/[.\\s-]/g,'_'); const instance=String(b.instance||data.instance||b.instanceName||''); const remoteJid=String(key.remoteJid||data.remoteJid||b.sender||b.from||''); const fromMe=Boolean(key.fromMe??data.fromMe??b.fromMe??false); if(fromMe||remoteJid==='status@broadcast'||remoteJid.endsWith('@g.us')||(remoteJid.includes('@')&&!remoteJid.endsWith('@s.whatsapp.net')&&!remoteJid.endsWith('@lid'))) return []; const message=data.message||b.message||{}; const raw=String(message.conversation||message.extendedTextMessage?.text||message.imageMessage?.caption||message.videoMessage?.caption||data.text||b.text||'').trim(); if(!raw||(event&&event!=='MESSAGES_UPSERT')) return []; const identityJid=String(key.remoteJidAlt||data.remoteJidAlt||remoteJid); const phone=identityJid.replace(/@.*/,'').replace(/[^0-9]/g,''); const selected=Number((raw.match(/(?:estudiante|opcion|opción)\\s*(\\d+)/i)||[])[1]||b.selected_student_id||0)||null; const t=raw.toLowerCase(); const intent=/estado de cuenta/.test(t)?'ESTADO_CUENTA':/(pagar|quiero pagar|pagar pensi[oó]n)/.test(t)?'PAGAR':/(cu[aá]nto debo|mi deuda|deuda|saldo)/.test(t)?'SALDO':'NO_SOPORTADA'; return [{json:{phone,text:raw,intent,selected_student_id:selected,event,instance,remote_jid:remoteJid,from_me:fromMe,correlation_id:$execution.id}}];"},
